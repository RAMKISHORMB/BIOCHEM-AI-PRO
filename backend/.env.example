# ==============================================================================
# BIOCHEM AI — Backend Environment Configuration
# ==============================================================================

PROJECT_NAME="BIOCHEM AI — Clinical Biochemistry Intelligence Platform"
VERSION="1.0.0"

SECRET_KEY="replace-this-with-a-cryptographically-secure-random-seed-value"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT="development"

# Initial Administrator Provisioning (Optional: First user registered becomes admin if unset)
ADMIN_EMAIL="admin@institution.org"
ADMIN_PASSWORD="replace-with-a-strong-unique-admin-password"

# PostgreSQL or local SQLite
DATABASE_URL="sqlite:///./biochem_ai.db"

# Local Ollama LLM
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_DEFAULT_MODEL="llama3"

# Persistent Storage
DATA_DIR="./data"
CHROMA_PERSIST_DIR="./data/chroma"
MODEL_REGISTRY_DIR="./data/models"
REPORT_OUTPUT_DIR="./data/reports"
